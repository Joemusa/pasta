NEXT_PUBLIC_DATA_SOURCE=demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Writes the latest scan to intelligence_feed so every Vercel
# instance (and the next deploy) can read it. Never expose as NEXT_PUBLIC_.
# Apply supabase/schema.sql first (table intelligence_feed).
SUPABASE_SERVICE_ROLE_KEY=

# X API v2 recent search (server-side only). Do not prefix with NEXT_PUBLIC_.
X_BEARER_TOKEN=
X_AGENT_ENABLED=true
X_MAX_POSTS=12
X_RELEVANCE_THRESHOLD=40
X_LOOKBACK_HOURS=48
X_QUERY_EXTRA=
